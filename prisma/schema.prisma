generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---
enum Role {
  USER
  SUPER_ADMIN
  BUSINESS_ADMIN
  FINANCE_ADMIN
}

enum BusinessType {
  SOLE_PROPRIETORSHIP
  PARTNERSHIP
  LIMITED_LIABILITY
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  MONO
  FILE_UPLOAD
}

enum ReviewStatus {
  AUTO_CATEGORIZED
  PENDING_REVIEW
  HUMAN_RESOLVED
}

enum VatStatus {
  TAGGED
  MISSING_VAT
  EXEMPT
}

// --- MODELS ---

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String?   // NEW
  lastName     String?   // NEW
  phone        String?   // NEW
  otpSecret    String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)
  isVerified   Boolean   @default(false)
  role         Role      @default(USER)
  lastReadNotificationsAt DateTime? @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business     Business? 
  auditLogs    AuditLog[]
}

model Business {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  name            String
  type            BusinessType
  industry        String
  tin             String?
  monoAccountId   String?  @unique 
  startingBalance Float?   @default(0) // <-- NEW: Saves the opening balance from AI
  taxBracket      String?  @default("SMALL") // CITA bracket: SMALL (0%), MEDIUM (20%), LARGE (30%)
  lastSyncedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions    Transaction[]
  savedMappings   SavedMapping[]
  categoryRules   BusinessCategoryRule[]
  customCategories Category[] @relation("CustomCategories")
}

model Category {
  id         String   @id @default(uuid())
  name       String
  slug       String
  isStandard Boolean  @default(true)
  businessId String?  // null = global standard, set = custom per-business
  business   Business? @relation("CustomCategories", fields: [businessId], references: [id], onDelete: Cascade)

  transactions  Transaction[]
  categoryRules BusinessCategoryRule[]

  @@unique([slug, businessId])
}

model Transaction {
  id          String            @id @default(uuid())
  businessId  String
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  categoryId  String?           
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  amount      Decimal           @db.Decimal(12, 2)
  date        DateTime
  description String
  source      TransactionSource @default(MANUAL)
  type        TransactionType
  vatStatus   VatStatus         @default(MISSING_VAT)
  reviewStatus ReviewStatus    @default(AUTO_CATEGORIZED)
  
  externalId  String?           @unique 
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  document    Document?         
}

model Document {
  id            String      @id @default(uuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  
  url           String      
  mimeType      String      
  
  createdAt     DateTime    @default(now())
}

// --- WAITLIST ENUMS ---
enum ReferralSource {
  TWITTER
  LINKEDIN
  INSTAGRAM
  FRIEND
  SEARCH
  OTHER
}

// --- WAITLIST MODEL ---
model Waitlist {
  id             String         @id @default(uuid())
  fullName       String
  email          String         @unique
  businessName   String
  businessType   BusinessType
  state          String
  referralSource ReferralSource?
  
  joinedAt       DateTime       @default(now())
}

// --- CONTACT MESSAGES ---
model ContactMessage {
  id        String   @id @default(uuid())
  fullName  String
  email     String
  topic     String
  message   String
  createdAt DateTime @default(now())
}

// --- COMPLIANCE AUDIT LOGGING ---
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  // Optional for failed logins
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action    String   // e.g., "AUTH.LOGIN", "AUTH.SIGNUP", "ADMIN.USER_DELETED"
  status    String   // SUCCESS, FAILURE, WARNING
  details   Json?    // Contextual metadata
  
  ip        String?
  userAgent String?
  
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SavedMapping {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  headerHash  String   // A hash of the sorted column names to identify this specific file format
  mapping     Json     // { "date": "Date", "description": "Narration", ... }
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, headerHash])
}

// --- PAYMENT RECORDS ---
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id        String        @id @default(uuid())
  reference String        @unique
  email     String
  amount    Int           // Amount in kobo
  status    PaymentStatus @default(PENDING)
  channel   String?       // e.g. "card", "bank", "ussd"
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([email])
  @@index([createdAt])
}

// --- TENANT-SPECIFIC CATEGORY RULES ---
model BusinessCategoryRule {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pattern     String   // lowercase normalized description pattern
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([businessId, pattern])
  @@index([businessId])
}

// --- BOOKING SYSTEM ---
model Booking {
  id           String   @id @default(uuid())
  fullName     String
  email        String
  companyName  String?
  notes        String?
  startTime    DateTime @unique // Handles race conditions at DB level
  endTime      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([startTime])
}
